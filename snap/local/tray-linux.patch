+  /// install, where tray_manager's own join leaves an absolute path alone.
+  static String get _trayIcon => Platform.isLinux
+      ? '${File(Platform.resolvedExecutable).parent.path}'
+            '/data/flutter_assets/$iconPath'
+      : iconPath;
